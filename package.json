{
  "name": "starve-project",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "configs/*"
  ],
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "typecheck:clean": "tsc --build tsconfig.json --clean",
    "test": "vitest run && bun run test:bun",
    "test:watch": "vitest",
    "test:bun": "bun test packages/server/src/database/repositories/PlayerRepository.spec.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "dev": "concurrently -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --filter '@starve/server' dev",
    "dev:client": "bun run --filter '@starve/client' dev",
    "build": "bun run typecheck && bun run --filter '@starve/client' build",
    "db:migrate": "bun run --filter '@starve/server' db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "concurrently": "^9.1.2",
    "@types/bun": "^1.2.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "core-js",
    "esbuild"
  ]
}
